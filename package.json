{
  "name": "obsidian-vcoder-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Connect an Obsidian vault to the vcoder CLI (/ide): selection sync, diff review, note diagnostics, openFile.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fake-ide": "node scripts/fake-ide.mjs",
    "release": "node scripts/release.mjs",
    "lint": "eslint src"
  },
  "keywords": [
    "obsidian",
    "vcoder",
    "mcp",
    "ide"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^8.0.2",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1"
  }
}
